//@version=5
indicator('MTF 추세 대시보드', shorttitle='MTF Trend', overlay=true)

// ══════════════════════════════════════════════════════
//  설정
// ══════════════════════════════════════════════════════
grp      = '지표 설정'
fastLen  = input.int(8,   '단기 DEMA 기간', minval=1, maxval=100, group=grp)
slowLen  = input.int(21,  '장기 DEMA 기간', minval=1, maxval=100, group=grp)
trendLen = input.int(233, 'EMA 필터 기간',  minval=1, maxval=500, group=grp)
adxLen   = input.int(14,  'ADX 기간',       minval=5, maxval=50,  group=grp)
adxWeak  = input.int(20,  'ADX 보통 기준',  minval=5, maxval=50,  group=grp)
adxStrong= input.int(25,  'ADX 강한 기준',  minval=5, maxval=50,  group=grp)

grpTbl  = '테이블 설정'
tblPos  = input.string('top_right', '위치', options=['top_right','top_left','bottom_right','bottom_left'], group=grpTbl)
tblSize = input.string('small', '크기', options=['tiny','small','normal','large'], group=grpTbl)

// ══════════════════════════════════════════════════════
//  헬퍼 함수
// ══════════════════════════════════════════════════════
dema(s, n) =>
    e = ta.ema(s, n)
    2.0 * e - ta.ema(e, n)

f_pos(p) =>
    if p == 'top_left'
        position.top_left
    else if p == 'bottom_right'
        position.bottom_right
    else if p == 'bottom_left'
        position.bottom_left
    else
        position.top_right

f_size(s) =>
    if s == 'tiny'
        size.tiny
    else if s == 'small'
        size.small
    else if s == 'large'
        size.large
    else
        size.normal

// ══════════════════════════════════════════════════════
//  각 시간프레임 데이터 수집 함수
//  반환: [EMA233 위 여부, DEMA 정배열 여부, ADX값]
// ══════════════════════════════════════════════════════
f_trend() =>
    d8   = dema(close, fastLen)
    d21  = dema(close, slowLen)
    e233 = ta.ema(close, trendLen)
    [_, _, adxV] = ta.dmi(adxLen, adxLen)
    [close > e233, d8 > d21, adxV]

// ══════════════════════════════════════════════════════
//  시간프레임별 데이터 요청
// ══════════════════════════════════════════════════════
[a5,   u5,   x5]   = request.security(syminfo.tickerid, "5",    f_trend())
[a15,  u15,  x15]  = request.security(syminfo.tickerid, "15",   f_trend())
[a60,  u60,  x60]  = request.security(syminfo.tickerid, "60",   f_trend())
[a240, u240, x240] = request.security(syminfo.tickerid, "240",  f_trend())
[a720, u720, x720] = request.security(syminfo.tickerid, "720",  f_trend())
[aD,   uD,   xD]   = request.security(syminfo.tickerid, "1D",   f_trend())
[aW,   uW,   xW]   = request.security(syminfo.tickerid, "1W",   f_trend())

// ══════════════════════════════════════════════════════
//  종합 판단 함수
// ══════════════════════════════════════════════════════
getJudge(above, up, adxV) =>
    txt = above and up and adxV >= adxStrong ? '🚀 강한상승' :
          above and up                        ? '▲ 상승' :
          above and not up                    ? '↗ 상승중약화' :
          not above and not up and adxV >= adxStrong ? '💥 강한하락' :
          not above and not up                ? '▼ 하락' :
                                               '↘ 하락중약화'
    col = above and up and adxV >= adxStrong  ? color.lime :
          above and up                         ? color.new(color.lime, 30) :
          above and not up                     ? color.yellow :
          not above and not up and adxV >= adxStrong ? color.red :
          not above and not up                 ? color.new(color.red, 30) :
                                                color.orange
    [txt, col]

// ══════════════════════════════════════════════════════
//  테이블
// ══════════════════════════════════════════════════════
var table tbl = table.new(f_pos(tblPos), 5, 9,
     bgcolor=color.new(color.black, 78),
     border_width=1, border_color=color.new(color.gray, 55))

if barstate.islast
    sz  = f_size(tblSize)
    hBg = color.new(#0d1b2a, 10)

    // ── 헤더 ──────────────────────────────────────────
    table.cell(tbl, 0, 0, '시간봉',   text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 1, 0, 'EMA'+str.tostring(trendLen), text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 2, 0, 'DEMA 배열', text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 3, 0, 'ADX',      text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 4, 0, '종합판단', text_color=color.white, text_size=sz, bgcolor=hBg)

    // ── 각 행 그리기 ──────────────────────────────────
    // 5분봉
    [jt5, jc5] = getJudge(a5, u5, x5)
    table.cell(tbl, 0, 1, '5분',     text_color=color.silver, text_size=sz)
    table.cell(tbl, 1, 1, a5  ? '▲ 위' : '▼ 아래', text_color=a5  ? color.lime : color.red, text_size=sz, bgcolor=color.new(a5  ? color.lime : color.red, 88))
    table.cell(tbl, 2, 1, u5  ? '▲ 정배열' : '▼ 역배열', text_color=u5  ? color.lime : color.red, text_size=sz)
    table.cell(tbl, 3, 1, str.tostring(x5,  '#.0'), text_color=x5  >= adxStrong ? color.lime : x5  >= adxWeak ? color.yellow : color.gray, text_size=sz)
    table.cell(tbl, 4, 1, jt5, text_color=jc5, text_size=sz, bgcolor=color.new(jc5, 88))

    // 15분봉
    [jt15, jc15] = getJudge(a15, u15, x15)
    table.cell(tbl, 0, 2, '15분',    text_color=color.silver, text_size=sz)
    table.cell(tbl, 1, 2, a15 ? '▲ 위' : '▼ 아래', text_color=a15 ? color.lime : color.red, text_size=sz, bgcolor=color.new(a15 ? color.lime : color.red, 88))
    table.cell(tbl, 2, 2, u15 ? '▲ 정배열' : '▼ 역배열', text_color=u15 ? color.lime : color.red, text_size=sz)
    table.cell(tbl, 3, 2, str.tostring(x15, '#.0'), text_color=x15 >= adxStrong ? color.lime : x15 >= adxWeak ? color.yellow : color.gray, text_size=sz)
    table.cell(tbl, 4, 2, jt15, text_color=jc15, text_size=sz, bgcolor=color.new(jc15, 88))

    // 1시간봉
    [jt60, jc60] = getJudge(a60, u60, x60)
    table.cell(tbl, 0, 3, '1시간',   text_color=color.silver, text_size=sz)
    table.cell(tbl, 1, 3, a60 ? '▲ 위' : '▼ 아래', text_color=a60 ? color.lime : color.red, text_size=sz, bgcolor=color.new(a60 ? color.lime : color.red, 88))
    table.cell(tbl, 2, 3, u60 ? '▲ 정배열' : '▼ 역배열', text_color=u60 ? color.lime : color.red, text_size=sz)
    table.cell(tbl, 3, 3, str.tostring(x60, '#.0'), text_color=x60 >= adxStrong ? color.lime : x60 >= adxWeak ? color.yellow : color.gray, text_size=sz)
    table.cell(tbl, 4, 3, jt60, text_color=jc60, text_size=sz, bgcolor=color.new(jc60, 88))

    // 4시간봉
    [jt240, jc240] = getJudge(a240, u240, x240)
    table.cell(tbl, 0, 4, '4시간',   text_color=color.silver, text_size=sz)
    table.cell(tbl, 1, 4, a240? '▲ 위' : '▼ 아래', text_color=a240? color.lime : color.red, text_size=sz, bgcolor=color.new(a240? color.lime : color.red, 88))
    table.cell(tbl, 2, 4, u240? '▲ 정배열' : '▼ 역배열', text_color=u240? color.lime : color.red, text_size=sz)
    table.cell(tbl, 3, 4, str.tostring(x240,'#.0'), text_color=x240>= adxStrong ? color.lime : x240>= adxWeak ? color.yellow : color.gray, text_size=sz)
    table.cell(tbl, 4, 4, jt240, text_color=jc240, text_size=sz, bgcolor=color.new(jc240, 88))

    // 12시간봉
    [jt720, jc720] = getJudge(a720, u720, x720)
    table.cell(tbl, 0, 5, '12시간',  text_color=color.silver, text_size=sz)
    table.cell(tbl, 1, 5, a720? '▲ 위' : '▼ 아래', text_color=a720? color.lime : color.red, text_size=sz, bgcolor=color.new(a720? color.lime : color.red, 88))
    table.cell(tbl, 2, 5, u720? '▲ 정배열' : '▼ 역배열', text_color=u720? color.lime : color.red, text_size=sz)
    table.cell(tbl, 3, 5, str.tostring(x720,'#.0'), text_color=x720>= adxStrong ? color.lime : x720>= adxWeak ? color.yellow : color.gray, text_size=sz)
    table.cell(tbl, 4, 5, jt720, text_color=jc720, text_size=sz, bgcolor=color.new(jc720, 88))

    // 일봉
    [jtD, jcD] = getJudge(aD, uD, xD)
    table.cell(tbl, 0, 6, '일봉',    text_color=color.silver, text_size=sz)
    table.cell(tbl, 1, 6, aD  ? '▲ 위' : '▼ 아래', text_color=aD  ? color.lime : color.red, text_size=sz, bgcolor=color.new(aD  ? color.lime : color.red, 88))
    table.cell(tbl, 2, 6, uD  ? '▲ 정배열' : '▼ 역배열', text_color=uD  ? color.lime : color.red, text_size=sz)
    table.cell(tbl, 3, 6, str.tostring(xD,  '#.0'), text_color=xD  >= adxStrong ? color.lime : xD  >= adxWeak ? color.yellow : color.gray, text_size=sz)
    table.cell(tbl, 4, 6, jtD, text_color=jcD, text_size=sz, bgcolor=color.new(jcD, 88))

    // 주봉
    [jtW, jcW] = getJudge(aW, uW, xW)
    table.cell(tbl, 0, 7, '주봉',    text_color=color.silver, text_size=sz)
    table.cell(tbl, 1, 7, aW  ? '▲ 위' : '▼ 아래', text_color=aW  ? color.lime : color.red, text_size=sz, bgcolor=color.new(aW  ? color.lime : color.red, 88))
    table.cell(tbl, 2, 7, uW  ? '▲ 정배열' : '▼ 역배열', text_color=uW  ? color.lime : color.red, text_size=sz)
    table.cell(tbl, 3, 7, str.tostring(xW,  '#.0'), text_color=xW  >= adxStrong ? color.lime : xW  >= adxWeak ? color.yellow : color.gray, text_size=sz)
    table.cell(tbl, 4, 7, jtW, text_color=jcW, text_size=sz, bgcolor=color.new(jcW, 88))

    // ── 전체 일치 카운트 ─────────────────────────────
    bullCnt = (a5  and u5  ? 1:0) + (a15 and u15 ? 1:0) + (a60  and u60  ? 1:0) +
              (a240 and u240? 1:0) + (a720 and u720? 1:0) + (aD   and uD   ? 1:0) + (aW and uW ? 1:0)
    bearCnt = (not a5  and not u5  ? 1:0) + (not a15 and not u15 ? 1:0) +
              (not a60  and not u60  ? 1:0) + (not a240 and not u240? 1:0) +
              (not a720 and not u720? 1:0) + (not aD   and not uD   ? 1:0) + (not aW and not uW ? 1:0)
    totalTxt = bullCnt >= 5 ? '🚀 전체 상승 우세' : bearCnt >= 5 ? '💥 전체 하락 우세' :
               bullCnt > bearCnt ? '↗ 상승 우세 ('+str.tostring(bullCnt)+'/7)' :
               bearCnt > bullCnt ? '↘ 하락 우세 ('+str.tostring(bearCnt)+'/7)' : '↔ 혼재'
    totalCol = bullCnt >= 5 ? color.lime : bearCnt >= 5 ? color.red :
               bullCnt > bearCnt ? color.new(color.lime,20) : bearCnt > bullCnt ? color.new(color.red,20) : color.gray

    table.cell(tbl, 0, 8, '전체',    text_color=color.white, text_size=sz, bgcolor=color.new(totalCol, 60))
    table.cell(tbl, 1, 8, totalTxt,  text_color=totalCol, text_size=sz, bgcolor=color.new(totalCol, 85))
    table.merge_cells(tbl, 1, 8, 4, 8)
