//@version=5
indicator('MTF 추세 대시보드', shorttitle='MTF Trend', overlay=true)

// ══════════════════════════════════════════════════════
//  설정
// ══════════════════════════════════════════════════════
grp       = '지표 설정'
fastLen   = input.int(21,  '단기 DEMA 기간', minval=1, maxval=100, group=grp)
slowLen   = input.int(55,  '장기 DEMA 기간', minval=1, maxval=100, group=grp)
trendLen  = input.int(233, 'EMA 필터 기간',  minval=1, maxval=500, group=grp)
adxLen    = input.int(14,  'ADX 기간',       minval=5, maxval=50,  group=grp)
adxWeak   = input.int(20,  'ADX 보통 기준',  minval=5, maxval=50,  group=grp)
adxStrong = input.int(25,  'ADX 강한 기준',  minval=5, maxval=50,  group=grp)
grpTbl    = '테이블 설정'
tblPos    = input.string('top_right', '위치', options=['top_right','top_left','bottom_right','bottom_left'], group=grpTbl)
tblSize   = input.string('small', '크기', options=['tiny','small','normal','large'], group=grpTbl)

// ══════════════════════════════════════════════════════
//  색상 상수
// ══════════════════════════════════════════════════════
C_UP   = color.new(#1B5E20, 0)   // 짙은 녹색 (상승)
C_DN   = color.new(color.red, 0) // 빨강 (하락)

// ══════════════════════════════════════════════════════
//  헬퍼 함수
// ══════════════════════════════════════════════════════
dema(s, n) =>
    e = ta.ema(s, n)
    2.0 * e - ta.ema(e, n)

f_pos(p) =>
    if p == 'top_left'
        position.top_left
    else if p == 'bottom_right'
        position.bottom_right
    else if p == 'bottom_left'
        position.bottom_left
    else
        position.top_right

f_size(s) =>
    if s == 'tiny'
        size.tiny
    else if s == 'small'
        size.small
    else if s == 'large'
        size.large
    else
        size.normal

// ══════════════════════════════════════════════════════
//  시간프레임 데이터 수집 함수
// ══════════════════════════════════════════════════════
f_trend() =>
    e21  = ta.ema(close, fastLen)
    e55  = ta.ema(close, slowLen)
    e233 = ta.ema(close, trendLen)
    [_, _, adxV] = ta.dmi(adxLen, adxLen)
    [close > e233, e21 > e55, adxV]

// ══════════════════════════════════════════════════════
//  종합 판단 함수
// ══════════════════════════════════════════════════════
getJudge(above, up, adxV) =>
    txt = above and up and adxV >= adxStrong ? '🚀 강한상승' :
          above and up                        ? '▲ 상승' :
          above and not up                    ? '↗ 상승중약화' :
          not above and not up and adxV >= adxStrong ? '💥 강한하락' :
          not above and not up                ? '▼ 하락' : '↘ 하락중약화'
    col = above and up and adxV >= adxStrong  ? C_UP :
          above and up                         ? color.new(#1B5E20, 20) :
          above and not up                     ? color.yellow :
          not above and not up and adxV >= adxStrong ? C_DN :
          not above and not up                 ? color.new(color.red, 20) : color.orange
    [txt, col]

// ══════════════════════════════════════════════════════
//  시간프레임별 데이터 요청 (1h, 4h, 12h, 일봉)
// ══════════════════════════════════════════════════════
[a60,  u60,  x60]  = request.security(syminfo.tickerid, "60",  f_trend())
[a240, u240, x240] = request.security(syminfo.tickerid, "240", f_trend())
[a720, u720, x720] = request.security(syminfo.tickerid, "720", f_trend())
[aD,   uD,   xD]   = request.security(syminfo.tickerid, "1D",  f_trend())

// ══════════════════════════════════════════════════════
//  테이블 생성  (5열 × 6행: 헤더 + 4봉 + 전체)
// ══════════════════════════════════════════════════════
var table tbl = table.new(f_pos(tblPos), 5, 6,
     bgcolor=color.new(color.black, 78),
     border_width=1, border_color=color.new(color.gray, 55))

// ══════════════════════════════════════════════════════
//  행 그리기 함수
// ══════════════════════════════════════════════════════
drawRow(row, nm, ab, up, adxV, sz) =>
    [jt, jc] = getJudge(ab, up, adxV)
    ac = ab   ? C_UP : C_DN
    uc = up   ? C_UP : C_DN
    xc = adxV >= adxStrong ? C_UP : adxV >= adxWeak ? color.yellow : color.gray
    table.cell(tbl, 0, row, nm,                         text_color=color.silver,        text_size=sz)
    table.cell(tbl, 1, row, ab?'▲ 위':'▼ 아래',          text_color=ac, text_size=sz,   bgcolor=color.new(ac, 88))
    table.cell(tbl, 2, row, up?'▲ EMA정배열':'▼ EMA역배열', text_color=uc, text_size=sz)
    table.cell(tbl, 3, row, str.tostring(adxV, '#.0'),  text_color=xc, text_size=sz)
    table.cell(tbl, 4, row, jt,                         text_color=jc, text_size=sz,   bgcolor=color.new(jc, 88))

// ══════════════════════════════════════════════════════
//  테이블 업데이트 (마지막 봉에서만)
// ══════════════════════════════════════════════════════
if barstate.islast
    sz  = f_size(tblSize)
    hBg = color.new(#0d1b2a, 10)

    // 헤더
    table.cell(tbl, 0, 0, '시간봉',              text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 1, 0, 'EMA' + str.tostring(trendLen), text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 2, 0, 'EMA 배열',            text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 3, 0, 'ADX',                 text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 4, 0, '종합판단',             text_color=color.white, text_size=sz, bgcolor=hBg)

    // 각 시간프레임 행
    drawRow(1, '1시간', a60,  u60,  x60,  sz)
    drawRow(2, '4시간', a240, u240, x240, sz)
    drawRow(3, '12시간',a720, u720, x720, sz)
    drawRow(4, '일봉',  aD,   uD,   xD,   sz)

    // 전체 합산 (4개 기준)
    bullCnt = (a60  and u60  ? 1:0) + (a240 and u240 ? 1:0) +
              (a720 and u720 ? 1:0) + (aD   and uD   ? 1:0)
    bearCnt = (not a60  and not u60  ? 1:0) + (not a240 and not u240 ? 1:0) +
              (not a720 and not u720 ? 1:0) + (not aD  and not uD   ? 1:0)

    totalTxt = bullCnt == 4 ? '🚀 전체 상승 우세' :
               bearCnt == 4 ? '💥 전체 하락 우세' :
               bullCnt > bearCnt ? '↗ 상승 우세 (' + str.tostring(bullCnt) + '/4)' :
               bearCnt > bullCnt ? '↘ 하락 우세 (' + str.tostring(bearCnt) + '/4)' : '↔ 혼재'
    totalCol = bullCnt == 4 ? C_UP :
               bearCnt == 4 ? C_DN  :
               bullCnt > bearCnt ? color.new(#1B5E20, 20) :
               bearCnt > bullCnt ? color.new(color.red, 20) : color.gray

    table.cell(tbl, 0, 5, '전체',    text_color=color.white, text_size=sz, bgcolor=color.new(totalCol, 60))
    table.cell(tbl, 1, 5, totalTxt, text_color=totalCol,    text_size=sz, bgcolor=color.new(totalCol, 85))
    table.merge_cells(tbl, 1, 5, 4, 5)
