//@version=5
indicator('DEMA 8/21 크로스 × EMA233 필터', shorttitle='DEMA Cross Filter', overlay=true)

// ══════════════════════════════════════════════════════
//  설정
// ══════════════════════════════════════════════════════
grpLine = '라인 설정'
src     = input.source(close, '소스', group=grpLine)
colD8   = input.color(#FF6B6B, 'DEMA 8  색상', group=grpLine)
colD21  = input.color(#FFD93D, 'DEMA 21 색상', group=grpLine)
colE233 = input.color(#4D96FF, 'EMA 233 색상', group=grpLine)
lwShort = input.int(2, '단기선 굵기 (8·21)', minval=1, maxval=4, group=grpLine)
lwLong  = input.int(3, '장기선 굵기 (233)',  minval=1, maxval=4, group=grpLine)

grpSig = '신호 설정'
showGC  = input.bool(true, '골든크로스 ▲ 표시', group=grpSig)
showDC  = input.bool(true, '데드크로스  ▼ 표시', group=grpSig)
showBg  = input.bool(true, 'EMA233 기준 배경색', group=grpSig)
showBar = input.bool(true, '캔들 색상 변경',     group=grpSig)
sigSize = input.string('normal', '신호 크기', options=['tiny','small','normal','large'], group=grpSig)

grpTbl = '테이블 설정'
tblPos  = input.string('top_right', '위치', options=['top_right','top_left','bottom_right','bottom_left'], group=grpTbl)
tblSize = input.string('small', '크기', options=['tiny','small','normal','large'], group=grpTbl)

// ══════════════════════════════════════════════════════
//  헬퍼 함수
// ══════════════════════════════════════════════════════
dema(s, n) =>
    e = ta.ema(s, n)
    2.0 * e - ta.ema(e, n)

f_pos(p) =>
    if p == 'top_left'
        position.top_left
    else if p == 'bottom_right'
        position.bottom_right
    else if p == 'bottom_left'
        position.bottom_left
    else
        position.top_right

f_size(s) =>
    if s == 'tiny'
        size.tiny
    else if s == 'small'
        size.small
    else if s == 'large'
        size.large
    else
        size.normal

// ══════════════════════════════════════════════════════
//  계산
// ══════════════════════════════════════════════════════
d8   = dema(src,  8)
d21  = dema(src, 21)
e233 = ta.ema(src, 233)

aboveEMA = close > e233   // EMA233 위 = 상승장
belowEMA = close < e233   // EMA233 아래 = 하락장

// 크로스 감지
isGC = ta.crossover(d8, d21)   // DEMA8이 DEMA21 상향 돌파
isDC = ta.crossunder(d8, d21)  // DEMA8이 DEMA21 하향 돌파

// EMA233 필터 적용
buySignal  = isGC and aboveEMA  // 골든크로스 + EMA233 위
sellSignal = isDC and belowEMA  // 데드크로스  + EMA233 아래

// ══════════════════════════════════════════════════════
//  라인 표시
// ══════════════════════════════════════════════════════
plot(d8,   'DEMA 8',   color=colD8,   linewidth=lwShort)
plot(d21,  'DEMA 21',  color=colD21,  linewidth=lwShort)
plot(e233, 'EMA 233',  color=colE233, linewidth=lwLong)

// EMA233 채우기 (가격 위치에 따라 색상)
e233Plot = plot(e233, display=display.none)
pricePlot = plot(close, display=display.none)
fill(e233Plot, pricePlot,
     color = aboveEMA ? color.new(color.lime, 93) : color.new(color.red, 93))

// ══════════════════════════════════════════════════════
//  신호 화살표
// ══════════════════════════════════════════════════════
sz = f_size(sigSize)

plotshape(showGC and buySignal,
     title='골든크로스', style=shape.labelup,
     location=location.belowbar,
     color=color.new(color.lime, 0), textcolor=color.black,
     text='GC', size=sz)

plotshape(showDC and sellSignal,
     title='데드크로스', style=shape.labeldown,
     location=location.abovebar,
     color=color.new(color.red, 0), textcolor=color.white,
     text='DC', size=sz)

// ══════════════════════════════════════════════════════
//  배경색 · 캔들 색상
// ══════════════════════════════════════════════════════
bgcolor(showBg and aboveEMA ? color.new(color.lime, 96) :
        showBg and belowEMA ? color.new(color.red,  96) : na,
        title='EMA233 배경')

barcolor(showBar and aboveEMA ? color.new(color.lime, 40) :
         showBar and belowEMA ? color.new(color.red,  40) : na,
         title='캔들 색상')

// ══════════════════════════════════════════════════════
//  정보 테이블
// ══════════════════════════════════════════════════════
var table tbl = table.new(f_pos(tblPos), 2, 5,
     bgcolor=color.new(color.black, 75),
     border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    ts        = f_size(tblSize)
    trendCol  = aboveEMA ? color.lime : color.red
    trendTxt  = aboveEMA ? '▲ 상승장 (골든만)' : '▼ 하락장 (데드만)'
    crossTxt  = isGC ? '⚡ 골든크로스!' : isDC ? '⚡ 데드크로스!' : '-'
    crossCol  = isGC ? color.lime : isDC ? color.red : color.gray

    table.cell(tbl, 0, 0, 'DEMA 8',  text_color=colD8,  text_size=ts)
    table.cell(tbl, 1, 0, str.tostring(d8,  '#.00'), text_color=colD8,  text_size=ts)

    table.cell(tbl, 0, 1, 'DEMA 21', text_color=colD21, text_size=ts)
    table.cell(tbl, 1, 1, str.tostring(d21, '#.00'), text_color=colD21, text_size=ts)

    table.cell(tbl, 0, 2, 'EMA 233', text_color=colE233, text_size=ts)
    table.cell(tbl, 1, 2, str.tostring(e233,'#.00'), text_color=colE233, text_size=ts)

    table.cell(tbl, 0, 3, '추세', text_color=color.white, text_size=ts,
               bgcolor=color.new(trendCol, 55))
    table.cell(tbl, 1, 3, trendTxt, text_color=trendCol, text_size=ts)

    table.cell(tbl, 0, 4, '크로스', text_color=color.white, text_size=ts)
    table.cell(tbl, 1, 4, crossTxt, text_color=crossCol, text_size=ts)

// ══════════════════════════════════════════════════════
//  알림
// ══════════════════════════════════════════════════════
alertcondition(buySignal,  '🟢 골든크로스 (EMA233 위)', 'DEMA8/21 골든크로스 — EMA233 위 매수 신호')
alertcondition(sellSignal, '🔴 데드크로스 (EMA233 아래)', 'DEMA8/21 데드크로스 — EMA233 아래 매도 신호')
