//@version=5
indicator('EMA 추세변환 신호', shorttitle='EMA Flip', overlay=true)

// ══════════════════════════════════════════════════════
//  EMA 설정
// ══════════════════════════════════════════════════════
grpMA = 'EMA 설정'
src    = input.source(close, '소스', group=grpMA)
len1   = input.int(9,   'EMA 1 기간', minval=1, maxval=500, group=grpMA)
len2   = input.int(25,  'EMA 2 기간', minval=1, maxval=500, group=grpMA)
len3   = input.int(50,  'EMA 3 기간', minval=1, maxval=500, group=grpMA)
len4   = input.int(200, 'EMA 4 기간', minval=1, maxval=500, group=grpMA)
col1   = input.color(#FF6B6B, 'EMA 1 색상', group=grpMA)
col2   = input.color(#FFD93D, 'EMA 2 색상', group=grpMA)
col3   = input.color(#6BCB77, 'EMA 3 색상', group=grpMA)
col4   = input.color(#4D96FF, 'EMA 4 색상', group=grpMA)
lw1    = input.int(1, 'EMA1·2 굵기', minval=1, maxval=4, group=grpMA)
lw2    = input.int(2, 'EMA3·4 굵기', minval=1, maxval=4, group=grpMA)

// ══════════════════════════════════════════════════════
//  신호 설정
// ══════════════════════════════════════════════════════
grpSig = '신호 설정'
show12 = input.bool(true,  'EMA1×EMA2 크로스 표시', group=grpSig)
show23 = input.bool(true,  'EMA2×EMA3 크로스 표시', group=grpSig)
show34 = input.bool(true,  'EMA3×EMA4 크로스 표시', group=grpSig)
showPC = input.bool(true,  '가격×EMA1 크로스 표시', group=grpSig)
showBg = input.bool(true,  'EMA1·EMA2 기준 배경색', group=grpSig)
sigSz  = input.string('normal', '신호 크기', options=['tiny','small','normal','large'], group=grpSig)

// ══════════════════════════════════════════════════════
//  테이블 설정
// ══════════════════════════════════════════════════════
grpTbl  = '테이블 설정'
tblPos  = input.string('top_right', '위치', options=['top_right','top_left','bottom_right','bottom_left'], group=grpTbl)
tblSize = input.string('small', '크기', options=['tiny','small','normal','large'], group=grpTbl)

// ══════════════════════════════════════════════════════
//  헬퍼 함수
// ══════════════════════════════════════════════════════
f_pos(p) =>
    if p == 'top_left'
        position.top_left
    else if p == 'bottom_right'
        position.bottom_right
    else if p == 'bottom_left'
        position.bottom_left
    else
        position.top_right

f_size(s) =>
    if s == 'tiny'
        size.tiny
    else if s == 'small'
        size.small
    else if s == 'large'
        size.large
    else
        size.normal

// ══════════════════════════════════════════════════════
//  EMA 계산
// ══════════════════════════════════════════════════════
e1 = ta.ema(src, len1)
e2 = ta.ema(src, len2)
e3 = ta.ema(src, len3)
e4 = ta.ema(src, len4)

// ══════════════════════════════════════════════════════
//  추세변환 감지
// ══════════════════════════════════════════════════════
// EMA1 × EMA2 (빠른 신호)
gc12 = ta.crossover(e1, e2)
dc12 = ta.crossunder(e1, e2)

// EMA2 × EMA3 (중간 신호)
gc23 = ta.crossover(e2, e3)
dc23 = ta.crossunder(e2, e3)

// EMA3 × EMA4 (느린 신호 — 강한 추세변환)
gc34 = ta.crossover(e3, e4)
dc34 = ta.crossunder(e3, e4)

// 가격 × EMA1 (진입 신호)
gcP1 = ta.crossover(src, e1)
dcP1 = ta.crossunder(src, e1)

// ══════════════════════════════════════════════════════
//  EMA 라인 표시
// ══════════════════════════════════════════════════════
plot(e1, 'EMA ' + str.tostring(len1), color=col1, linewidth=lw1)
plot(e2, 'EMA ' + str.tostring(len2), color=col2, linewidth=lw1)
plot(e3, 'EMA ' + str.tostring(len3), color=col3, linewidth=lw2)
plot(e4, 'EMA ' + str.tostring(len4), color=col4, linewidth=lw2)

// ══════════════════════════════════════════════════════
//  배경색 (EMA1 > EMA2 기준)
// ══════════════════════════════════════════════════════
bgcolor(showBg and e1 > e2 ? color.new(color.lime, 95) :
        showBg and e1 < e2 ? color.new(color.red,  95) : na,
        title='EMA1·2 추세 배경')

// ══════════════════════════════════════════════════════
//  신호 화살표 — Pine Script const string 제약으로 분리
// ══════════════════════════════════════════════════════
// ── EMA1 × EMA2
plotshape(show12 and gc12 and sigSz=='tiny',   'GC12', shape.triangleup,   location.belowbar, color.new(color.lime,0),  text='1×2↑', textcolor=color.black, size=size.tiny)
plotshape(show12 and gc12 and sigSz=='small',  'GC12', shape.triangleup,   location.belowbar, color.new(color.lime,0),  text='1×2↑', textcolor=color.black, size=size.small)
plotshape(show12 and gc12 and sigSz=='normal', 'GC12', shape.triangleup,   location.belowbar, color.new(color.lime,0),  text='1×2↑', textcolor=color.black, size=size.normal)
plotshape(show12 and gc12 and sigSz=='large',  'GC12', shape.triangleup,   location.belowbar, color.new(color.lime,0),  text='1×2↑', textcolor=color.black, size=size.large)
plotshape(show12 and dc12 and sigSz=='tiny',   'DC12', shape.triangledown, location.abovebar, color.new(color.red,0),   text='1×2↓', textcolor=color.white, size=size.tiny)
plotshape(show12 and dc12 and sigSz=='small',  'DC12', shape.triangledown, location.abovebar, color.new(color.red,0),   text='1×2↓', textcolor=color.white, size=size.small)
plotshape(show12 and dc12 and sigSz=='normal', 'DC12', shape.triangledown, location.abovebar, color.new(color.red,0),   text='1×2↓', textcolor=color.white, size=size.normal)
plotshape(show12 and dc12 and sigSz=='large',  'DC12', shape.triangledown, location.abovebar, color.new(color.red,0),   text='1×2↓', textcolor=color.white, size=size.large)

// ── EMA2 × EMA3
plotshape(show23 and gc23 and sigSz=='tiny',   'GC23', shape.labelup,   location.belowbar, color.new(#00BFFF,0), textcolor=color.black, text='2×3↑', size=size.tiny)
plotshape(show23 and gc23 and sigSz=='small',  'GC23', shape.labelup,   location.belowbar, color.new(#00BFFF,0), textcolor=color.black, text='2×3↑', size=size.small)
plotshape(show23 and gc23 and sigSz=='normal', 'GC23', shape.labelup,   location.belowbar, color.new(#00BFFF,0), textcolor=color.black, text='2×3↑', size=size.normal)
plotshape(show23 and gc23 and sigSz=='large',  'GC23', shape.labelup,   location.belowbar, color.new(#00BFFF,0), textcolor=color.black, text='2×3↑', size=size.large)
plotshape(show23 and dc23 and sigSz=='tiny',   'DC23', shape.labeldown, location.abovebar, color.new(#FF6600,0), textcolor=color.white, text='2×3↓', size=size.tiny)
plotshape(show23 and dc23 and sigSz=='small',  'DC23', shape.labeldown, location.abovebar, color.new(#FF6600,0), textcolor=color.white, text='2×3↓', size=size.small)
plotshape(show23 and dc23 and sigSz=='normal', 'DC23', shape.labeldown, location.abovebar, color.new(#FF6600,0), textcolor=color.white, text='2×3↓', size=size.normal)
plotshape(show23 and dc23 and sigSz=='large',  'DC23', shape.labeldown, location.abovebar, color.new(#FF6600,0), textcolor=color.white, text='2×3↓', size=size.large)

// ── EMA3 × EMA4 (가장 강한 신호 — 큰 별 모양)
plotshape(show34 and gc34 and sigSz=='tiny',   'GC34', shape.flag,     location.belowbar, color.new(color.yellow,0), textcolor=color.black, text='3×4↑', size=size.tiny)
plotshape(show34 and gc34 and sigSz=='small',  'GC34', shape.flag,     location.belowbar, color.new(color.yellow,0), textcolor=color.black, text='3×4↑', size=size.small)
plotshape(show34 and gc34 and sigSz=='normal', 'GC34', shape.flag,     location.belowbar, color.new(color.yellow,0), textcolor=color.black, text='3×4↑', size=size.normal)
plotshape(show34 and gc34 and sigSz=='large',  'GC34', shape.flag,     location.belowbar, color.new(color.yellow,0), textcolor=color.black, text='3×4↑', size=size.large)
plotshape(show34 and dc34 and sigSz=='tiny',   'DC34', shape.flag,     location.abovebar, color.new(color.purple,0), textcolor=color.white, text='3×4↓', size=size.tiny)
plotshape(show34 and dc34 and sigSz=='small',  'DC34', shape.flag,     location.abovebar, color.new(color.purple,0), textcolor=color.white, text='3×4↓', size=size.small)
plotshape(show34 and dc34 and sigSz=='normal', 'DC34', shape.flag,     location.abovebar, color.new(color.purple,0), textcolor=color.white, text='3×4↓', size=size.normal)
plotshape(show34 and dc34 and sigSz=='large',  'DC34', shape.flag,     location.abovebar, color.new(color.purple,0), textcolor=color.white, text='3×4↓', size=size.large)

// ── 가격 × EMA1 (점 신호)
plotshape(showPC and gcP1 and sigSz=='tiny',   'GCP1', shape.circle, location.belowbar, color.new(color.lime,20), size=size.tiny)
plotshape(showPC and gcP1 and sigSz=='small',  'GCP1', shape.circle, location.belowbar, color.new(color.lime,20), size=size.small)
plotshape(showPC and gcP1 and sigSz=='normal', 'GCP1', shape.circle, location.belowbar, color.new(color.lime,20), size=size.normal)
plotshape(showPC and gcP1 and sigSz=='large',  'GCP1', shape.circle, location.belowbar, color.new(color.lime,20), size=size.large)
plotshape(showPC and dcP1 and sigSz=='tiny',   'DCP1', shape.circle, location.abovebar, color.new(color.red,20),  size=size.tiny)
plotshape(showPC and dcP1 and sigSz=='small',  'DCP1', shape.circle, location.abovebar, color.new(color.red,20),  size=size.small)
plotshape(showPC and dcP1 and sigSz=='normal', 'DCP1', shape.circle, location.abovebar, color.new(color.red,20),  size=size.normal)
plotshape(showPC and dcP1 and sigSz=='large',  'DCP1', shape.circle, location.abovebar, color.new(color.red,20),  size=size.large)

// ══════════════════════════════════════════════════════
//  정렬 상태 계산
// ══════════════════════════════════════════════════════
c1 = close > e1
c2 = e1    > e2
c3 = e2    > e3
c4 = e3    > e4
bullCnt = (c1?1:0)+(c2?1:0)+(c3?1:0)+(c4?1:0)

alignTxt = bullCnt==4 ? '완전 정배열' : bullCnt==3 ? '부분 정배열' :
           bullCnt==0 ? '완전 역배열' : bullCnt==1 ? '부분 역배열' : '혼재'
alignCol = bullCnt==4 ? color.lime : bullCnt==3 ? #6BCB77 :
           bullCnt==0 ? color.red  : bullCnt==1 ? color.orange : color.gray

// ══════════════════════════════════════════════════════
//  정보 테이블
// ══════════════════════════════════════════════════════
var table tbl = table.new(f_pos(tblPos), 3, 7,
     bgcolor=color.new(color.black, 75),
     border_width=1, border_color=color.new(color.gray, 55))

if barstate.islast
    sz  = f_size(tblSize)
    hBg = color.new(#1A1A2E, 10)

    table.cell(tbl, 0, 0, 'EMA',    text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 1, 0, '현재값', text_color=color.white, text_size=sz, bgcolor=hBg)
    table.cell(tbl, 2, 0, '위치',   text_color=color.white, text_size=sz, bgcolor=hBg)

    table.cell(tbl, 0, 1, 'EMA '+str.tostring(len1), text_color=col1, text_size=sz)
    table.cell(tbl, 1, 1, str.tostring(e1, '#.00'),  text_color=col1, text_size=sz)
    table.cell(tbl, 2, 1, c1?'▲ 가격위':'▼ 가격아래', text_color=c1?color.lime:color.red, text_size=sz)

    table.cell(tbl, 0, 2, 'EMA '+str.tostring(len2), text_color=col2, text_size=sz)
    table.cell(tbl, 1, 2, str.tostring(e2, '#.00'),  text_color=col2, text_size=sz)
    table.cell(tbl, 2, 2, c2?'▲ EMA1위':'▼ EMA1아래', text_color=c2?color.lime:color.red, text_size=sz)

    table.cell(tbl, 0, 3, 'EMA '+str.tostring(len3), text_color=col3, text_size=sz)
    table.cell(tbl, 1, 3, str.tostring(e3, '#.00'),  text_color=col3, text_size=sz)
    table.cell(tbl, 2, 3, c3?'▲ EMA2위':'▼ EMA2아래', text_color=c3?color.lime:color.red, text_size=sz)

    table.cell(tbl, 0, 4, 'EMA '+str.tostring(len4), text_color=col4, text_size=sz)
    table.cell(tbl, 1, 4, str.tostring(e4, '#.00'),  text_color=col4, text_size=sz)
    table.cell(tbl, 2, 4, c4?'▲ EMA3위':'▼ EMA3아래', text_color=c4?color.lime:color.red, text_size=sz)

    table.cell(tbl, 0, 5, '──', text_color=color.gray, text_size=sz)
    table.cell(tbl, 1, 5, '──', text_color=color.gray, text_size=sz)
    table.cell(tbl, 2, 5, '──', text_color=color.gray, text_size=sz)

    table.cell(tbl, 0, 6, '배열',     text_color=color.white, text_size=sz, bgcolor=color.new(alignCol, 60))
    table.cell(tbl, 1, 6, alignTxt,   text_color=alignCol,    text_size=sz)
    table.cell(tbl, 2, 6, str.tostring(bullCnt)+' / 4', text_color=color.white, text_size=sz)

// ══════════════════════════════════════════════════════
//  알림
// ══════════════════════════════════════════════════════
alertcondition(gc12, '📈 EMA1×2 골든크로스', 'EMA' + str.tostring(len1) + ' × EMA' + str.tostring(len2) + ' 골든크로스')
alertcondition(dc12, '📉 EMA1×2 데드크로스', 'EMA' + str.tostring(len1) + ' × EMA' + str.tostring(len2) + ' 데드크로스')
alertcondition(gc23, '📈 EMA2×3 골든크로스', 'EMA' + str.tostring(len2) + ' × EMA' + str.tostring(len3) + ' 골든크로스')
alertcondition(dc23, '📉 EMA2×3 데드크로스', 'EMA' + str.tostring(len2) + ' × EMA' + str.tostring(len3) + ' 데드크로스')
alertcondition(gc34, '🚀 EMA3×4 골든크로스 (강한신호)', 'EMA' + str.tostring(len3) + ' × EMA' + str.tostring(len4) + ' 골든크로스 — 강한 추세변환')
alertcondition(dc34, '💥 EMA3×4 데드크로스 (강한신호)', 'EMA' + str.tostring(len3) + ' × EMA' + str.tostring(len4) + ' 데드크로스 — 강한 추세변환')
