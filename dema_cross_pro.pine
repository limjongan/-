//@version=5
indicator('DEMA Cross Pro (TP/SL + RSI + 추세전환)', shorttitle='DEMA Pro', overlay=true)

// ══════════════════════════════════════════════════════
//  라인 설정
// ══════════════════════════════════════════════════════
grpLine  = '라인 설정'
src      = input.source(close, '소스', group=grpLine)
fastLen  = input.int(8,   '단기 DEMA 기간', minval=1, maxval=200, group=grpLine)
slowLen  = input.int(21,  '장기 DEMA 기간', minval=1, maxval=200, group=grpLine)
trendLen = input.int(233, 'EMA 필터 기간',  minval=1, maxval=500, group=grpLine)
colFast  = input.color(#FF6B6B, '단기 DEMA 색상', group=grpLine)
colSlow  = input.color(#FFD93D, '장기 DEMA 색상', group=grpLine)
colTrend = input.color(#4D96FF, 'EMA 필터 색상',  group=grpLine)
lwShort  = input.int(2, '단기선 굵기', minval=1, maxval=4, group=grpLine)
lwLong   = input.int(3, '필터선 굵기', minval=1, maxval=4, group=grpLine)

// ══════════════════════════════════════════════════════
//  노이즈 감소 필터
// ══════════════════════════════════════════════════════
grpFilter   = '노이즈 감소 필터'
useAdx      = input.bool(true,  'ADX 필터',           group=grpFilter)
adxThresh   = input.int(15,     'ADX 최소값',          minval=5,  maxval=50,  group=grpFilter)
adxLen      = input.int(14,     'ADX 기간',            minval=5,  maxval=50,  group=grpFilter)
useCooldown = input.bool(true,  '쿨다운 (연속 차단)',   group=grpFilter)
cooldownBar = input.int(5,      '쿨다운 봉 수',        minval=1,  maxval=50,  group=grpFilter)
useGap      = input.bool(true,  'DEMA 간격 필터',      group=grpFilter)
gapMult     = input.float(0.3,  'DEMA 간격 ATR 배수',  minval=0.1, maxval=2.0, step=0.1, group=grpFilter)

// ══════════════════════════════════════════════════════
//  RSI 필터
// ══════════════════════════════════════════════════════
grpRsi   = 'RSI 필터'
useRsi   = input.bool(true, 'RSI 필터 사용',        group=grpRsi)
rsiLen   = input.int(14,    'RSI 기간',             minval=2, maxval=50, group=grpRsi)
rsiBull  = input.int(50,    'GC 최소 RSI (이상일때 매수)', minval=30, maxval=70, group=grpRsi)
rsiBear  = input.int(50,    'DC 최대 RSI (이하일때 매도)', minval=30, maxval=70, group=grpRsi)

// ══════════════════════════════════════════════════════
//  TP / SL 설정
// ══════════════════════════════════════════════════════
grpTpsl  = 'TP / SL 설정'
showTpSl = input.bool(true,  'TP/SL 라인 표시',  group=grpTpsl)
atrLen   = input.int(14,     'ATR 기간',          minval=5, maxval=50, group=grpTpsl)
slMult   = input.float(1.5,  '손절(SL) ATR 배수', minval=0.5, maxval=5.0, step=0.5, group=grpTpsl)
tp1Mult  = input.float(1.5,  'TP1 ATR 배수',      minval=0.5, maxval=5.0, step=0.5, group=grpTpsl)
tp2Mult  = input.float(3.0,  'TP2 ATR 배수',      minval=1.0, maxval=10.0, step=0.5, group=grpTpsl)
colSL    = input.color(color.new(color.red,   20), 'SL  색상', group=grpTpsl)
colTP1   = input.color(color.new(color.lime,  20), 'TP1 색상', group=grpTpsl)
colTP2   = input.color(color.new(color.green, 20), 'TP2 색상', group=grpTpsl)

// ══════════════════════════════════════════════════════
//  추세 전환 신호 설정
// ══════════════════════════════════════════════════════
grpFlip     = '추세 전환 신호 (EMA 돌파)'
showFlip    = input.bool(true, '추세 전환 신호 표시', group=grpFlip)
colBullFlip = input.color(color.new(color.aqua,   0), '상승 전환 색상', group=grpFlip)
colBearFlip = input.color(color.new(color.orange,  0), '하락 전환 색상', group=grpFlip)

// ══════════════════════════════════════════════════════
//  신호 · 테이블 설정
// ══════════════════════════════════════════════════════
grpSig  = '신호 설정'
showGC  = input.bool(true,     '골든크로스 표시', group=grpSig)
showDC  = input.bool(true,     '데드크로스 표시', group=grpSig)
showBg  = input.bool(true,     '배경색 표시',     group=grpSig)
showBar = input.bool(true,     '캔들 색상 변경',  group=grpSig)
sigSize = input.string('normal','신호 크기', options=['tiny','small','normal','large'], group=grpSig)
grpTbl  = '테이블 설정'
tblPos  = input.string('top_right','위치', options=['top_right','top_left','bottom_right','bottom_left'], group=grpTbl)
tblSize = input.string('small',    '크기', options=['tiny','small','normal','large'], group=grpTbl)

// ══════════════════════════════════════════════════════
//  헬퍼 함수
// ══════════════════════════════════════════════════════
dema(s, n) =>
    e = ta.ema(s, n)
    2.0 * e - ta.ema(e, n)

f_pos(p) =>
    if p == 'top_left'
        position.top_left
    else if p == 'bottom_right'
        position.bottom_right
    else if p == 'bottom_left'
        position.bottom_left
    else
        position.top_right

f_size(s) =>
    if s == 'tiny'
        size.tiny
    else if s == 'small'
        size.small
    else if s == 'large'
        size.large
    else
        size.normal

// ══════════════════════════════════════════════════════
//  계산
// ══════════════════════════════════════════════════════
dFast  = dema(src, fastLen)
dSlow  = dema(src, slowLen)
eTrend = ta.ema(src, trendLen)
atrVal = ta.atr(atrLen)
rsiVal = ta.rsi(src, rsiLen)

aboveEMA = close > eTrend
belowEMA = close < eTrend

[_, _, adxVal] = ta.dmi(adxLen, adxLen)
adxOk    = not useAdx      or adxVal > adxThresh
gapOk    = not useGap       or math.abs(dFast - dSlow) > atrVal * gapMult
rsiGcOk  = not useRsi       or rsiVal >= rsiBull
rsiDcOk  = not useRsi       or rsiVal <= rsiBear

isGC = ta.crossover(dFast, dSlow)
isDC = ta.crossunder(dFast, dSlow)

var int lastGC = -999
var int lastDC = -999

// 쿨다운 체크를 업데이트보다 먼저 — 업데이트 후 체크하면 항상 0>=N 으로 차단됨
gcCoolOk = not useCooldown or (bar_index - lastGC) >= cooldownBar
dcCoolOk = not useCooldown or (bar_index - lastDC) >= cooldownBar

buySignal  = isGC and aboveEMA and adxOk and gapOk and gcCoolOk and rsiGcOk
sellSignal = isDC and belowEMA and adxOk and gapOk and dcCoolOk and rsiDcOk

// 신호 발생 후 쿨다운 타이머 업데이트
if buySignal
    lastGC := bar_index
if sellSignal
    lastDC := bar_index

// 추세 전환 (DEMA단기가 EMA필터 돌파)
bullFlip = showFlip and ta.crossover(dFast,  eTrend)
bearFlip = showFlip and ta.crossunder(dFast, eTrend)

// ══════════════════════════════════════════════════════
//  TP / SL 라인 관리
// ══════════════════════════════════════════════════════
var line[]  slLines  = array.new_line()
var line[]  tp1Lines = array.new_line()
var line[]  tp2Lines = array.new_line()
var label[] slLbls   = array.new_label()
var label[] tp1Lbls  = array.new_label()
var label[] tp2Lbls  = array.new_label()
var float[] slLvls   = array.new_float()
var float[] tp1Lvls  = array.new_float()
var float[] tp2Lvls  = array.new_float()
var bool[]  buyFlags = array.new_bool()

// 가격이 SL 또는 TP2 도달 시 라인 삭제
if showTpSl and array.size(slLines) > 0
    i = array.size(slLines) - 1
    while i >= 0
        sl  = array.get(slLvls,  i)
        tp2 = array.get(tp2Lvls, i)
        buy = array.get(buyFlags, i)
        hit = buy ? (low <= sl or high >= tp2) : (high >= sl or low <= tp2)
        if hit
            line.delete(array.get(slLines,  i))
            line.delete(array.get(tp1Lines, i))
            line.delete(array.get(tp2Lines, i))
            label.delete(array.get(slLbls,  i))
            label.delete(array.get(tp1Lbls, i))
            label.delete(array.get(tp2Lbls, i))
            array.remove(slLines,  i)
            array.remove(tp1Lines, i)
            array.remove(tp2Lines, i)
            array.remove(slLbls,   i)
            array.remove(tp1Lbls,  i)
            array.remove(tp2Lbls,  i)
            array.remove(slLvls,   i)
            array.remove(tp1Lvls,  i)
            array.remove(tp2Lvls,  i)
            array.remove(buyFlags, i)
        i -= 1

// 신호 발생 시 TP/SL 라인 생성
if showTpSl and (buySignal or sellSignal)
    isBuy   = buySignal
    slPrice  = isBuy ? low  - atrVal * slMult  : high + atrVal * slMult
    tp1Price = isBuy ? close + atrVal * tp1Mult : close - atrVal * tp1Mult
    tp2Price = isBuy ? close + atrVal * tp2Mult : close - atrVal * tp2Mult

    lSL  = line.new(bar_index, slPrice,  bar_index+1, slPrice,  color=colSL,  width=1, style=line.style_dashed, extend=extend.right)
    lTP1 = line.new(bar_index, tp1Price, bar_index+1, tp1Price, color=colTP1, width=1, style=line.style_dashed, extend=extend.right)
    lTP2 = line.new(bar_index, tp2Price, bar_index+1, tp2Price, color=colTP2, width=2, style=line.style_dashed, extend=extend.right)

    lblSL  = label.new(bar_index, slPrice,  '✂ SL\n'  + str.tostring(slPrice,  '#.0'), style=label.style_label_right, color=colSL,  textcolor=color.white, size=size.tiny)
    lblTP1 = label.new(bar_index, tp1Price, '🎯 TP1\n' + str.tostring(tp1Price, '#.0'), style=label.style_label_right, color=colTP1, textcolor=color.black, size=size.tiny)
    lblTP2 = label.new(bar_index, tp2Price, '🚀 TP2\n' + str.tostring(tp2Price, '#.0'), style=label.style_label_right, color=colTP2, textcolor=color.black, size=size.tiny)

    array.push(slLines,  lSL)
    array.push(tp1Lines, lTP1)
    array.push(tp2Lines, lTP2)
    array.push(slLbls,   lblSL)
    array.push(tp1Lbls,  lblTP1)
    array.push(tp2Lbls,  lblTP2)
    array.push(slLvls,   slPrice)
    array.push(tp1Lvls,  tp1Price)
    array.push(tp2Lvls,  tp2Price)
    array.push(buyFlags, isBuy)

// ══════════════════════════════════════════════════════
//  라인 표시
// ══════════════════════════════════════════════════════
plot(dFast,  'DEMA 단기', color=colFast,  linewidth=lwShort)
plot(dSlow,  'DEMA 장기', color=colSlow,  linewidth=lwShort)
plot(eTrend, 'EMA 필터',  color=colTrend, linewidth=lwLong)

eTrendPlot = plot(eTrend, display=display.none)
pricePlot  = plot(close,  display=display.none)
fill(eTrendPlot, pricePlot,
     color=aboveEMA ? color.new(color.lime,93) : color.new(color.red,93))

// ══════════════════════════════════════════════════════
//  신호 화살표 (size별 분리)
// ══════════════════════════════════════════════════════
gcT=showGC and buySignal  and sigSize=='tiny'
gcS=showGC and buySignal  and sigSize=='small'
gcN=showGC and buySignal  and sigSize=='normal'
gcL=showGC and buySignal  and sigSize=='large'
dcT=showDC and sellSignal and sigSize=='tiny'
dcS=showDC and sellSignal and sigSize=='small'
dcN=showDC and sellSignal and sigSize=='normal'
dcL=showDC and sellSignal and sigSize=='large'

plotshape(gcT,title='GC',style=shape.labelup,  location=location.belowbar,color=color.new(color.lime,0),textcolor=color.black,text='GC',size=size.tiny)
plotshape(gcS,title='GC',style=shape.labelup,  location=location.belowbar,color=color.new(color.lime,0),textcolor=color.black,text='GC',size=size.small)
plotshape(gcN,title='GC',style=shape.labelup,  location=location.belowbar,color=color.new(color.lime,0),textcolor=color.black,text='GC',size=size.normal)
plotshape(gcL,title='GC',style=shape.labelup,  location=location.belowbar,color=color.new(color.lime,0),textcolor=color.black,text='GC',size=size.large)
plotshape(dcT,title='DC',style=shape.labeldown,location=location.abovebar,color=color.new(color.red,0), textcolor=color.white,text='DC',size=size.tiny)
plotshape(dcS,title='DC',style=shape.labeldown,location=location.abovebar,color=color.new(color.red,0), textcolor=color.white,text='DC',size=size.small)
plotshape(dcN,title='DC',style=shape.labeldown,location=location.abovebar,color=color.new(color.red,0), textcolor=color.white,text='DC',size=size.normal)
plotshape(dcL,title='DC',style=shape.labeldown,location=location.abovebar,color=color.new(color.red,0), textcolor=color.white,text='DC',size=size.large)

// 추세 전환 신호
plotshape(bullFlip, title='상승전환', style=shape.triangleup,   location=location.belowbar, color=colBullFlip, size=size.small)
plotshape(bearFlip, title='하락전환', style=shape.triangledown, location=location.abovebar, color=colBearFlip, size=size.small)

// ══════════════════════════════════════════════════════
//  배경색 · 캔들 색상
// ══════════════════════════════════════════════════════
bgcolor(showBg and aboveEMA ? color.new(color.lime,96) :
        showBg and belowEMA ? color.new(color.red, 96) : na)
barcolor(showBar and aboveEMA ? color.new(color.lime,40) :
         showBar and belowEMA ? color.new(color.red, 40) : na)

// ══════════════════════════════════════════════════════
//  정보 테이블
// ══════════════════════════════════════════════════════
var table tbl = table.new(f_pos(tblPos), 2, 9,
     bgcolor=color.new(color.black,75),
     border_width=1, border_color=color.new(color.gray,60))

if barstate.islast
    ts       = f_size(tblSize)
    trendCol = aboveEMA ? color.lime : color.red
    adxCol   = adxVal > adxThresh ? color.lime : color.orange
    rsiCol   = rsiVal > 70 ? color.red : rsiVal < 30 ? color.lime : color.white
    crossTxt = buySignal ? '⚡ GC 신호!' : sellSignal ? '⚡ DC 신호!' : bullFlip ? '▲ 상승전환' : bearFlip ? '▼ 하락전환' : '-'
    crossCol = buySignal ? color.lime : sellSignal ? color.red : bullFlip ? color.aqua : bearFlip ? color.orange : color.gray

    table.cell(tbl,0,0,'DEMA '+str.tostring(fastLen), text_color=colFast,  text_size=ts)
    table.cell(tbl,1,0,str.tostring(dFast,'#.00'),    text_color=colFast,  text_size=ts)
    table.cell(tbl,0,1,'DEMA '+str.tostring(slowLen), text_color=colSlow,  text_size=ts)
    table.cell(tbl,1,1,str.tostring(dSlow,'#.00'),    text_color=colSlow,  text_size=ts)
    table.cell(tbl,0,2,'EMA '+str.tostring(trendLen), text_color=colTrend, text_size=ts)
    table.cell(tbl,1,2,str.tostring(eTrend,'#.00'),   text_color=colTrend, text_size=ts)
    table.cell(tbl,0,3,'RSI('+str.tostring(rsiLen)+')', text_color=color.white, text_size=ts)
    table.cell(tbl,1,3,str.tostring(rsiVal,'#.0'),    text_color=rsiCol,   text_size=ts)
    table.cell(tbl,0,4,'ADX('+str.tostring(adxLen)+')', text_color=color.white, text_size=ts)
    table.cell(tbl,1,4,str.tostring(adxVal,'#.0'),    text_color=adxCol,   text_size=ts)
    table.cell(tbl,0,5,'추세', text_color=color.white, text_size=ts, bgcolor=color.new(trendCol,55))
    table.cell(tbl,1,5,aboveEMA?'▲ 상승장':'▼ 하락장', text_color=trendCol, text_size=ts)
    table.cell(tbl,0,6,'ADX 필터', text_color=color.white, text_size=ts)
    table.cell(tbl,1,6,useAdx?(adxVal>adxThresh?'✅ 통과':'❌ 차단'):'⬜ 비사용', text_color=adxCol, text_size=ts)
    rsiFilterTxt = not useRsi ? '⬜ 비사용' : aboveEMA ? (rsiVal>=rsiBull?'✅ 매수OK':'❌ RSI낮음') : (rsiVal<=rsiBear?'✅ 매도OK':'❌ RSI높음')
    rsiFilterCol = not useRsi ? color.gray : aboveEMA ? (rsiVal>=rsiBull?color.lime:color.orange) : (rsiVal<=rsiBear?color.lime:color.orange)
    table.cell(tbl,0,7,'RSI 필터', text_color=color.white, text_size=ts)
    table.cell(tbl,1,7,rsiFilterTxt, text_color=rsiFilterCol, text_size=ts)
    table.cell(tbl,0,8,'신호', text_color=color.white, text_size=ts)
    table.cell(tbl,1,8,crossTxt, text_color=crossCol, text_size=ts)

// ══════════════════════════════════════════════════════
//  알림
// ══════════════════════════════════════════════════════
alertcondition(buySignal,  '🟢 GC 매수 신호', 'DEMA 골든크로스 — 필터 통과 매수')
alertcondition(sellSignal, '🔴 DC 매도 신호', 'DEMA 데드크로스 — 필터 통과 매도')
alertcondition(bullFlip,   '🔵 상승 추세 전환', 'DEMA가 EMA필터 상향 돌파 — 상승장 전환')
alertcondition(bearFlip,   '🟠 하락 추세 전환', 'DEMA가 EMA필터 하향 돌파 — 하락장 전환')
